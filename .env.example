WORDPRESS_URL=https://ton-site.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Necessaire pour envoyer des images locales dans la bibliotheque WordPress.
# A creer dans WordPress : Utilisateurs > Profil > Mots de passe d'application.
WORDPRESS_USER=ton_identifiant_wordpress
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optionnel : pour generer les descriptions depuis les photos et notes brutes.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Optionnel : selon la version API disponible pour ton compte.
# Si web_search_preview ne fonctionne pas, essayer web_search.
OPENAI_WEB_TOOL_TYPE=web_search_preview
